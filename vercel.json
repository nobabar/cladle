{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "framework": "nuxtjs",
  "devCommand": "pnpm run dev",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": true,
      "feature/*": false,
      "release/*": false,
      "hotfix/*": false
    },
    "previewBranches": [
      "feature/*",
      "release/*",
      "hotfix/*"
    ]
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
}
